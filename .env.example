# κ-Distribution Conformance — Environment Configuration
# Loaded by direnv as operational defaults. Override in .env (gitignored).

# =============================================================================
# Required
# =============================================================================
# Base URL of the registry under test (scheme required, no trailing slash)
KAPPA_REGISTRY_URL=http://localhost:8080

# =============================================================================
# Scope
# =============================================================================
# Namespace prefix for test data (should be empty before each run)
KAPPA_NAMESPACE=_conformance/test/v1:conformance

# Conformance levels to execute (comma-separated, 1-5)
KAPPA_TEST_LEVELS=1,2,3,4,5

# =============================================================================
# Authentication
# =============================================================================
# Bearer token (raw value, binary prepends "Bearer ")
#KAPPA_AUTH_TOKEN=

# HTTP Basic (used only if KAPPA_AUTH_TOKEN is unset)
#KAPPA_AUTH_USERNAME=
#KAPPA_AUTH_PASSWORD=

# =============================================================================
# Behavior
# =============================================================================
# Per-operation HTTP timeout (seconds)
KAPPA_TIMEOUT=30

# Chunk size for chunked upload tests (bytes)
KAPPA_UPLOAD_CHUNK_SIZE=1048576

# Teardown order: tags-first | blobs-first
KAPPA_TEARDOWN_ORDER=tags-first

# Whether to clean up test data after run
KAPPA_TEARDOWN_ENABLED=true

# Follow HTTP redirects
KAPPA_FOLLOW_REDIRECTS=true

# =============================================================================
# Federation (Level 5)
# =============================================================================
# Peer registry URLs for federation tests (comma-separated, skip if empty)
#KAPPA_FEDERATION_PEERS=https://peer1.example.com,https://peer2.example.com

# =============================================================================
# Output
# =============================================================================
# Directory for JUnit XML + HTML reports
KAPPA_REPORT_DIR=./kappa-conformance-report/
